# ============================================================================
# Modelo de configuracao da IA do Albert (chat de duvidas).
# COPIE este arquivo para server/.env e preencha a chave. O .env real NAO vai
# pro Git (ver .gitignore) - a chave e segredo e fica so na sua maquina.
# ============================================================================

# Fornecedor da IA: gemini (padrao) | claude | mock
IA_PROVIDER=gemini

# --- Gemini (Google AI Studio - free tier) ---
# Gere a chave em https://aistudio.google.com/apikey e cole aqui.
GEMINI_API_KEY=
# Modelo (free tier). gemini-flash-lite-latest: rapido e sempre atual (bom pro
# chat). Alternativas: gemini-flash-latest, gemini-3.5-flash.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Claude (Anthropic) - alternativa; precisa de chave + credito ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
